<Window x:Class="PitzkiLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pitzki Launcher" Width="720" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" FlowDirection="LeftToRight" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="10,7" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#262938"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#4A3BA8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResultTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" FlowDirection="LeftToRight">
                    <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                               Foreground="#B9A6FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Sub}" Foreground="#A0A4B8" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding KindText}" Foreground="#8E92A8" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Margin="18" Background="#F215161C" CornerRadius="18" BorderBrush="#3A3D50" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Border.RenderTransform>
        <StackPanel Margin="14,12,14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="PitzkiImg" Width="44" Height="44" FlowDirection="LeftToRight" RenderTransformOrigin="0.5,1">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="PitzkiJump"/>
                    </Image.RenderTransform>
                </Image>
                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <TextBox x:Name="QueryBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                             FontSize="22" VerticalContentAlignment="Center" Padding="2,4" SelectionBrush="#7C5CFF"/>
                    <TextBlock x:Name="Hint" Text="What to open? An app, file, setting, math…" Foreground="#5F6378" FontSize="22"
                               IsHitTestVisible="False" VerticalAlignment="Center" Margin="4,0"/>
                </Grid>
            </Grid>
            <Border x:Name="Divider" Height="1" Background="#2C2F3E" Margin="0,10,0,4"/>
            <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" Focusable="False"
                     ItemContainerStyle="{StaticResource ItemStyle}" ItemTemplate="{StaticResource ResultTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="Results_Click"/>
            <TextBlock x:Name="Footer" Foreground="#6B6F82" FontSize="11.5" Margin="6,6,6,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
